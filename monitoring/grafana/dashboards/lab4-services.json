    {
      "type": "stat",
      "title": "Healthy instances per service",
      "description": "Scrape/probe availability. Domain services run two replicas; Gateway, Service Discovery and Broker run one.",
      "targets": [
        {
          "expr": "sum by (job) (up{job!~\"prometheus|service-health\"})",
          "legendFormat": "{{job}}"
        },
        {
          "expr": "sum by (service) (probe_success{job=\"service-health\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "timeseries",
