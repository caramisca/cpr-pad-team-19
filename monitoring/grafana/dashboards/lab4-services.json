      },
      "id": 6,
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Average request duration per service",
      "description": "Mean = duration sum / request count. Not a percentile.",
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum{job=~\"player-service|server-moderation-session-service|server-rules-service|university-record-service\",uri!~\"/actuator.*|/health.*\"}[1m])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"player-service|server-moderation-session-service|server-rules-service|university-record-service\",uri!~\"/actuator.*|/health.*\"}[1m]))",
          "legendFormat": "{{job}} HTTP"
        },
        {
          "expr": "sum by (job) (rate(service_request_duration_seconds_sum[1m])) / sum by (job) (rate(service_requests_total[1m]))",
          "legendFormat": "{{job}}"
        },
        {
          "expr": "sum by (job) (rate(grpc_server_seconds_sum{rpc_method=\"Call\"}[1m])) / sum by (job) (rate(grpc_server_seconds_count{rpc_method=\"Call\"}[1m]))",
          "legendFormat": "{{job}} gRPC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
