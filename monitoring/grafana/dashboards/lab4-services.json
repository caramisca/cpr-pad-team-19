    {
      "type": "timeseries",
      "title": "Request rate per service (req/s)",
      "description": "",
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"player-service|server-moderation-session-service|server-rules-service|university-record-service\",uri!~\"/actuator.*|/health.*\"}[1m]))",
          "legendFormat": "{{job}} HTTP"
        },
        {
          "expr": "sum by (job) (rate(service_requests_total[1m]))",
          "legendFormat": "{{job}}"
        },
        {
          "expr": "sum by (job) (rate(grpc_server_seconds_count{rpc_method=\"Call\"}[1m]))",
          "legendFormat": "{{job}} gRPC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate per service (5xx / failed gRPC, req/s)",
      "description": "",
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"player-service|server-moderation-session-service|server-rules-service|university-record-service\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{job}} HTTP 5xx"
        },
        {
          "expr": "sum by (job) (rate(service_errors_total[1m]))",
          "legendFormat": "{{job}} 5xx"
        },
        {
          "expr": "sum by (job) (rate(grpc_server_seconds_count{grpc_status_code!=\"OK\"}[1m]))",
          "legendFormat": "{{job}} gRPC error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
