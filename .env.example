# Copy to .env before running `docker compose up` at the repo root - .env is gitignored, never
# commit real credentials. Covers all 8 services wired into docker-compose.yml.

RULES_MONGO_USERNAME=admin
RULES_MONGO_PASSWORD=changeme
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
RULES_MAX_THREADS=200
RULES_REQUEST_TIMEOUT_MS=5000

# Part of a Npgsql connection string, so the password must not contain ';'.
MODERATION_POSTGRES_USER=moderation
MODERATION_POSTGRES_PASSWORD=changeme
# Required (Lab 5): moderation-postgres is a replicated cluster (moderation-postgres-1..3), like
# player-postgres. The superuser (postgres) is only used by Patroni inside the cluster; the
# replication login (replicator) by the standbys. Use different passwords, and change them before the
# cluster is first created: they are set when it is bootstrapped (a new value needs
# `docker compose down -v`).
MODERATION_POSTGRES_SUPERUSER_PASSWORD=changeme-superuser
MODERATION_POSTGRES_REPLICATION_PASSWORD=changeme-replication
# Optional — defaults apply if omitted (8 000 ms timeout, at most 100 requests at once)
MODERATION_REQUEST_TIMEOUT_MS=8000
MODERATION_MAX_CONCURRENT_REQUESTS=100
# Optional — defaults apply if omitted (2 replicas, each registered with service-discovery)
MODERATION_REPLICAS=2

# Part of a StackExchange.Redis connection string, so the password must not contain ','. Since
# Lab 5 one password for the three members of dms-redis and their three Sentinels; it is also sent
# inside the HAProxy health check, so it must not contain spaces or quotes either.
DMS_REDIS_PASSWORD=changeme
# Optional — default 172.30.58: the first three octets of the private network dms-redis-ha, on which
# the three members (.11-.13) and three Sentinels (.21-.23) of dms-redis have fixed addresses. Set
# another value only if that /24 is already in use on this host (e.g. a second Compose project).
DMS_REDIS_HA_IP_PREFIX=172.30.58
# Optional — defaults apply if omitted (8 000 ms timeout, at most 100 requests at once)
DMS_REQUEST_TIMEOUT_MS=8000
DMS_MAX_CONCURRENT_REQUESTS=100
# Optional — defaults apply if omitted (1 replica besides discord-dms-service, which publishes 8088
# for the chat; each registered with service-discovery)
DMS_EXTRA_REPLICAS=1

RECORD_POSTGRES_USER=university_record
RECORD_POSTGRES_PASSWORD=changeme
# Required (Lab 5): record-postgres is now a Patroni 3-member cluster (record-postgres-1..3).
# These passwords are set when the cluster is first bootstrapped; changing them later needs
# `docker compose down -v` on the record-postgres volumes.
RECORD_POSTGRES_SUPERUSER_PASSWORD=changeme-superuser
RECORD_POSTGRES_REPLICATION_PASSWORD=changeme-replication
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
RECORD_MAX_THREADS=200
RECORD_REQUEST_TIMEOUT_MS=5000

# Part of a StackExchange.Redis connection string, so the passwords must not contain ','.
APPLICANT_REDIS_PASSWORD=changeme
CREDENTIAL_REDIS_PASSWORD=changeme
# Three-octet prefix for the private Redis HA /24. Use a different prefix for a second Compose project.
REDIS_HA_IP_PREFIX=172.30.57
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
APPLICANT_MAX_THREADS=200
APPLICANT_REQUEST_TIMEOUT_MS=5000
CREDENTIAL_MAX_THREADS=200
CREDENTIAL_REQUEST_TIMEOUT_MS=5000

PLAYER_POSTGRES_USER=player_service
PLAYER_POSTGRES_PASSWORD=changeme
# Required (Lab 5): player-postgres is a replicated cluster (player-postgres-1..3). The superuser
# (postgres) is only used by Patroni inside the cluster; the replication login (replicator) by the
# standbys. Use different passwords, and change them before the cluster is first created: they are
# set when the cluster is bootstrapped (a new value needs `docker compose down -v`).
PLAYER_POSTGRES_SUPERUSER_PASSWORD=changeme-superuser
PLAYER_POSTGRES_REPLICATION_PASSWORD=changeme-replication
# Optional — defaults apply if omitted (task timeout 10s, at most 20 requests at once)
PLAYER_TASK_TIMEOUT=10s
PLAYER_MAX_CONCURRENT_TASKS=20
# Optional — defaults apply if omitted (2 replicas, each registered with service-discovery)
PLAYER_REPLICAS=2

SESSION_POSTGRES_USER=session_service
SESSION_POSTGRES_PASSWORD=changeme
# Required (Lab 5): the same for the replicated session-postgres cluster (session-postgres-1..3).
SESSION_POSTGRES_SUPERUSER_PASSWORD=changeme-superuser
SESSION_POSTGRES_REPLICATION_PASSWORD=changeme-replication
# Optional — defaults apply if omitted (10 applicants per shift, task timeout 10s, at most 20
# requests at once)
SESSION_MAX_APPLICANTS_PER_SHIFT=10
SESSION_TASK_TIMEOUT=10s
SESSION_MAX_CONCURRENT_TASKS=20
# Optional — defaults apply if omitted: the difficulty asked of applicant-service (EASY, MEDIUM or
# HARD), and the live streams (GET /sessions/{id}/events): at most 100 open per replica, each ended
# after 30m, a keep-alive every 15s (keep it below the gateway's 30 s read timeout).
SESSION_APPLICANT_DIFFICULTY=MEDIUM
SESSION_SSE_MAX_CONNECTIONS=100
SESSION_SSE_TIMEOUT=30m
SESSION_SSE_HEARTBEAT=15s
# Optional — defaults apply if omitted (2 replicas, each registered with service-discovery)
SESSION_REPLICAS=2
# Optional — how session-service calls applicant-service: http (through the gateway, the default) or
# broker (gRPC MessageBroker.Call, Lab 4). Set broker only together with docker-compose.lab4-mihai.yml,
# which gives applicant-service the gRPC endpoint the broker calls.
SESSION_APPLICANT_CLIENT_MODE=http
# Optional — the same for session-service's call to server-rules-service: http (default) or broker. Set
# broker once the server-rules-service image serves its gRPC ServiceEndpoint (Lab 4, port 9085).
SESSION_RULES_CLIENT_MODE=http
# Optional — Lab 5, Grade 8: how POST /sessions/{id}/close closes a shift: two-phase (default: with
# player-service's database in one two-phase commit, coordinated by message-broker) or event (the
# Lab 4 way: locally, then session.closed). See docs/LAB_5_TWO_PHASE_COMMIT.md.
SESSION_SHIFT_CLOSE_MODE=two-phase

# API keys for the gateway: clients send "Authorization: Bearer <key>" on http://localhost:8080.
# <client>:<key> pairs separated by commas, each key at least 32 bytes. Generate a real key with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and put it in .env only. Without any key, the gateway answers every request with
# 503 AUTHORIZATION_UNAVAILABLE.
GATEWAY_API_KEYS=postman:replace-with-a-random-key-of-32-bytes-or-more
# Required for WebSocket ticket negotiation (POST /ws/negotiate): the gateway signs the chat tickets
# with it, and discord-dms-service accepts only tickets signed with it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_WS_TICKET_SECRET=replace-with-a-random-secret-of-32-bytes-or-more
# Public WebSocket URL of discord-dms-service, returned by /ws/negotiate
DMS_PUBLIC_WS_URL=ws://localhost:8088
# Optional — defaults apply if omitted (10 s timeout, at most 200 requests at once)
GATEWAY_REQUEST_TIMEOUT_SECONDS=10
GATEWAY_MAX_CONCURRENT_REQUESTS=200
# Lab 4, Grade 6: broker routing. When set, gateway-service forwards calls to the services listed
# in BROKER_ROUTED_SERVICES through the message-broker instead of directly. Leave empty to keep
# direct routing (the gateway falls back to its own load-balancer).
# Format: host:port (plain gRPC, no scheme). Inside Compose: message-broker:9091.
BROKER_GRPC_URL=message-broker:9091
# Optional (Lab 5, Grade 9) — the decision-verdict saga the gateway coordinates
# (docs/LAB_5_SAGA.md). Defaults apply if omitted: 3 attempts per step, 5 s per attempt, backoff
# 1 s doubling up to 30 s, the recovery loop every 5 s, and POST /sagas/decision-verdicts waits up to
# 8 s for the outcome before it answers 202 with the saga to poll. The step delay holds every step
# back, for demonstrations only (0 = off).
GATEWAY_SAGA_STEP_ATTEMPTS=3
GATEWAY_SAGA_STEP_TIMEOUT_SECONDS=5
GATEWAY_SAGA_RETRY_BACKOFF_SECONDS=1
GATEWAY_SAGA_MAX_BACKOFF_SECONDS=30
GATEWAY_SAGA_RECOVERY_INTERVAL_SECONDS=5
GATEWAY_SAGA_RESPONSE_TIMEOUT_SECONDS=8
GATEWAY_SAGA_STEP_DELAY_SECONDS=0

# Application replicas and Service Discovery
# These replicas require the Lab 3 registration code and shared Redis storage.
APPLICANT_REPLICAS=2
CREDENTIAL_REPLICAS=2
RULES_REPLICAS=2
RECORD_REPLICAS=2
GATEWAY_SD_POLL_INTERVAL_SECONDS=5
DISCOVERY_INSTANCE_TTL_SECONDS=30
DISCOVERY_POLL_INTERVAL_SECONDS=10
DISCOVERY_MAX_CONCURRENT_REQUESTS=200
DISCOVERY_REQUEST_TIMEOUT_SECONDS=5
# Optional — health alerts from the Service Discovery to the developers; left empty, they are only
# logged. The webhook URL and the bot token are secrets: put them in .env only.
# Discord: the channel's settings, Integrations, Webhooks, New Webhook, Copy Webhook URL.
DISCOVERY_ALERT_DISCORD_WEBHOOK_URL=
# Telegram: the token @BotFather gives the bot, and the chat it sends to: a numeric ID (negative
# for a group) or a public channel's @name. Set both, or neither.
DISCOVERY_ALERT_TELEGRAM_BOT_TOKEN=
DISCOVERY_ALERT_TELEGRAM_CHAT_ID=
# The same alert is sent at most once in this many seconds.
DISCOVERY_ALERT_COOLDOWN_SECONDS=300

# Laboratory 4 — Message Broker (message-broker, private to the Compose network, no secrets).
# Optional — defaults apply if omitted (32 requests worked on at once, INFO logs)
BROKER_MAX_THREADS=32
BROKER_LOG_LEVEL=INFO
# Optional — Lab 5 demonstrations only: seconds the two-phase commit coordinator waits between its
# decision and phase 2, so a participant, a database or the broker can be killed in between
# (scripts/check_two_phase_commit.py needs e.g. 3). 0 (default) = no wait.
BROKER_TWO_PHASE_PHASE_TWO_DELAY_SECONDS=0

# Lab 5, Grade 4: data warehouse and ETL job.
WAREHOUSE_DB_PASSWORD=changeme
# Optional — how often (in seconds) the ETL job runs. Defaults to 300 (5 minutes).
ETL_INTERVAL_SECONDS=300

# Lab 5 Gateway cache overlay. Set a separate password before sharing the environment.
GATEWAY_CACHE_PASSWORD=change-this-gateway-cache-password
# GATEWAY_CACHE_RESPONSE_TTL_SECONDS=15
# GATEWAY_CACHE_AUTH_TTL_SECONDS=60
