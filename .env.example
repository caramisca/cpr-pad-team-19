# Copy to .env before running `docker compose up` at the repo root - .env is gitignored, never
# commit real credentials. Covers the services currently wired into docker-compose.yml
# (server-rules-service, university-record-service); other members should add their own vars
# here as their services join the shared compose file.

RULES_MONGO_USERNAME=admin
RULES_MONGO_PASSWORD=changeme

RECORD_POSTGRES_USER=university_record
RECORD_POSTGRES_PASSWORD=changeme
