# Copy to .env before running `docker compose up` at the repo root - .env is gitignored, never
# commit real credentials. Covers all 8 services wired into docker-compose.yml.

RULES_MONGO_USERNAME=admin
RULES_MONGO_PASSWORD=changeme
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
RULES_MAX_THREADS=200
RULES_REQUEST_TIMEOUT_MS=5000

# Part of a Npgsql connection string, so the password must not contain ';'.
MODERATION_POSTGRES_USER=moderation
MODERATION_POSTGRES_PASSWORD=changeme
# Optional — defaults apply if omitted (8 000 ms timeout, at most 100 requests at once)
MODERATION_REQUEST_TIMEOUT_MS=8000
MODERATION_MAX_CONCURRENT_REQUESTS=100

# Part of a StackExchange.Redis connection string, so the password must not contain ','.
DMS_REDIS_PASSWORD=changeme
# Optional — defaults apply if omitted (8 000 ms timeout, at most 100 requests at once)
DMS_REQUEST_TIMEOUT_MS=8000
DMS_MAX_CONCURRENT_REQUESTS=100

RECORD_POSTGRES_USER=university_record
RECORD_POSTGRES_PASSWORD=changeme
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
RECORD_MAX_THREADS=200
RECORD_REQUEST_TIMEOUT_MS=5000

# Part of a StackExchange.Redis connection string, so the passwords must not contain ','.
APPLICANT_REDIS_PASSWORD=changeme
CREDENTIAL_REDIS_PASSWORD=changeme
# Optional — defaults apply if omitted (max 200 threads, 5 000 ms timeout)
APPLICANT_MAX_THREADS=200
APPLICANT_REQUEST_TIMEOUT_MS=5000
CREDENTIAL_MAX_THREADS=200
CREDENTIAL_REQUEST_TIMEOUT_MS=5000

PLAYER_POSTGRES_USER=player_service
PLAYER_POSTGRES_PASSWORD=changeme
# Optional — defaults apply if omitted (task timeout 10s, at most 20 requests at once)
PLAYER_TASK_TIMEOUT=10s
PLAYER_MAX_CONCURRENT_TASKS=20

SESSION_POSTGRES_USER=session_service
SESSION_POSTGRES_PASSWORD=changeme
# Optional — defaults apply if omitted (10 applicants per shift, task timeout 10s, at most 20
# requests at once)
SESSION_MAX_APPLICANTS_PER_SHIFT=10
SESSION_TASK_TIMEOUT=10s
SESSION_MAX_CONCURRENT_TASKS=20

# API keys for the gateway: clients send "Authorization: Bearer <key>" on http://localhost:8080.
# <client>:<key> pairs separated by commas, each key at least 32 bytes. Generate a real key with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and put it in .env only. Without any key, the gateway answers every request with
# 503 AUTHORIZATION_UNAVAILABLE.
GATEWAY_API_KEYS=postman:replace-with-a-random-key-of-32-bytes-or-more
# Required for WebSocket ticket negotiation (POST /ws/negotiate): the gateway signs the chat tickets
# with it, and discord-dms-service accepts only tickets signed with it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_WS_TICKET_SECRET=replace-with-a-random-secret-of-32-bytes-or-more
# Public WebSocket URL of discord-dms-service, returned by /ws/negotiate
DMS_PUBLIC_WS_URL=ws://localhost:8088
# Optional — defaults apply if omitted (10 s timeout, at most 200 requests at once)
GATEWAY_REQUEST_TIMEOUT_SECONDS=10
GATEWAY_MAX_CONCURRENT_REQUESTS=200
