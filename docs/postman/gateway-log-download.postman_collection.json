                  "const body = pm.response.json();",
                  "pm.test(\"is a validation error\", () => pm.expect(body.error).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"names the parameter\", () => pm.expect(body.message).to.include(\"service\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs?service=billing-service",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "service",
                  "value": "billing-service"
                }
              ]
            }
          }
        },
        {
          "name": "Limit Zero Returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a validation error\", () => pm.expect(body.error).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"names the parameter\", () => pm.expect(body.message).to.include(\"limit\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs?limit=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Since After Until Returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a validation error\", () => pm.expect(body.error).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"names the parameter\", () => pm.expect(body.message).to.include(\"since\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs?since=2026-11-12T10:00:00Z&until=2026-11-12T09:00:00Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "2026-11-12T10:00:00Z"
                },
                {
                  "key": "until",
                  "value": "2026-11-12T09:00:00Z"
                }
              ]
            }
          }
        },
        {
          "name": "Unknown Parameter Returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a validation error\", () => pm.expect(body.error).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"names the parameter\", () => pm.expect(body.message).to.include(\"level\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs?level=error",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "level",
                  "value": "error"
                }
              ]
            }
          }
        },
        {
          "name": "Download Without An API Key Returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"is unauthorized\", () => pm.expect(pm.response.json().error).to.eql(\"UNAUTHORIZED\"));",
                  "pm.test(\"asks for a bearer key\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "traceRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unknownNotificationId",
      "value": "",
      "type": "string"
    }
  ]
}
