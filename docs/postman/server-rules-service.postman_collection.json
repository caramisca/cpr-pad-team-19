          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules\": [\n    {\n      \"type\": \"ALLOWED_FACULTY\",\n      \"description\": \"FAF only\",\n      \"params\": {\n        \"faculties\": [\n          \"FAF\"\n        ]\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rulesets",
