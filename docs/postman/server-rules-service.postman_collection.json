{
  "info": {
    "name": "server-rules-service",
    "description": "Ruleset CRUD + revision-history endpoints for server-rules-service (Team 19, Topic 3 \u2014 Student ID, Please). Run requests top to bottom, or use the Collection Runner \u2014 later requests depend on {{rulesetId}} captured from the Publish Ruleset Revision response. The service seeds one default ruleset on boot, so GET /rulesets/active always has data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "rulesetId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rulesetVersion",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Get Active Ruleset (Seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has at least one rule\", () => pm.expect(body.rules.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rulesets/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "active"
              ]
            }
          }
        },
        {
          "name": "Publish Ruleset Revision",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"response has id and rules\", () => {",
                  "  pm.expect(body.id).to.be.a(\"string\");",
                  "  pm.expect(body.rules).to.have.lengthOf(2);",
                  "});",
                  "pm.collectionVariables.set(\"rulesetId\", body.id);",
                  "pm.collectionVariables.set(\"rulesetVersion\", body.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectiveFrom\": \"{{$isoTimestamp}}\",\n  \"rules\": [\n    {\n      \"type\": \"ALLOWED_FACULTY\",\n      \"description\": \"Only FAF and FCIM applicants are accepted\",\n      \"params\": {\n        \"faculties\": [\n          \"FAF\",\n          \"FCIM\"\n        ]\n      }\n    },\n    {\n      \"type\": \"MIN_ENROLLMENT_YEARS\",\n      \"description\": \"Applicant must be enrolled at least 1 year\",\n      \"params\": {\n        \"minYears\": 1\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rulesets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets"
              ]
            }
          }
        },
        {
          "name": "Get Ruleset By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"id matches published ruleset\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"rulesetId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rulesets/{{rulesetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "{{rulesetId}}"
              ]
            }
          }
        },
        {
          "name": "Get Active Ruleset After Publish",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"active ruleset is the one just published\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"rulesetId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rulesets/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "active"
              ]
            }
          }
        },
        {
          "name": "Get Ruleset Revisions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"rulesetId echoes the requested id\", () => pm.expect(body.rulesetId).to.eql(pm.collectionVariables.get(\"rulesetId\")));",
                  "pm.test(\"includes the latest revision\", () => {",
                  "  const latest = body.revisions[body.revisions.length - 1];",
                  "  pm.expect(String(latest.revisionNumber)).to.eql(String(pm.collectionVariables.get(\"rulesetVersion\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rulesets/{{rulesetId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "{{rulesetId}}",
                "revisions"
              ]
            }
          }
        },
        {
          "name": "Update Ruleset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"rules were replaced\", () => pm.expect(body.rules).to.have.lengthOf(1));",
                  "pm.test(\"id unchanged\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"rulesetId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectiveFrom\": \"{{$isoTimestamp}}\",\n  \"rules\": [\n    {\n      \"type\": \"ALLOWED_FACULTY\",\n      \"description\": \"Updated via PUT\",\n      \"params\": { \"faculties\": [\"FCIM\"] }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rulesets/{{rulesetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "{{rulesetId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Ruleset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/rulesets/{{rulesetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets",
                "{{rulesetId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
