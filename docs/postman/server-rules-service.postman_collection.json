                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is RULESET_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"RULESET_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
