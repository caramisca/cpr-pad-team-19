            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectiveFrom\": \"{{$isoTimestamp}}\",\n  \"rules\": [\n    { \"type\": \"ALLOWED_FACULTY\", \"description\": \"x\", \"params\": {} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rulesets/00000000-0000-0000-0000-000000000000",
