            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectiveFrom\": \"2026-01-01T00:00:00Z\",\n  \"rules\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rulesets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rulesets"
              ]
            }
          }
        },
        {
          "name": "Publish Ruleset Missing EffectiveFrom Returns 400",
          "event": [
            {
