  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Enable only for the final Lab 4 Gateway integration; diagnostics have separate tests.",
          "if (pm.variables.get(\"runLab4GatewayChecks\") === \"true\") {",
          "  const path = pm.request.url.getPath();",
          "  if (path === \"/credentials\" || path.startsWith(\"/credentials/\")) {",
          "    if (pm.response.code !== 204 && pm.response.text().trim()) {",
          "      pm.test(\"Lab 4: HTTP JSON Content-Type survives the broker\", function () {",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json(?:;|$)/i);",
          "      });",
          "    }",
          "    const filter = pm.variables.replaceIn(pm.request.url.query.get(\"applicantId\") || \"\");",
          "    if (pm.request.method === \"GET\" && path === \"/credentials\" && filter && pm.response.code === 200) {",
          "      pm.test(\"Lab 4: Gateway retains the query filter\", function () {",
          "        const rows = pm.response.json().credentials;",
          "        pm.expect(rows).to.be.an(\"array\");",
          "        rows.forEach(row => pm.expect(row.applicantId).to.eql(filter));",
          "      });",
          "    }",
          "  }",
          "}"
        ]
      }
    }
