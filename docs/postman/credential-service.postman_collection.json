{
  "info": {
    "name": "credential-service",
    "description": "Credential bundle endpoints of credential-service (Team 19, Topic 3 â€” Student ID, Please). Runs against the shared docker-compose.yml through the API Gateway (baseUrl http://localhost:8080) with collection-level Authorization: Bearer {{apiKey}}. The Happy Path folder issues, verifies, reissues and revokes its own bundles, so it can be run repeatedly. Run the folders in order. Lab 4: service calls use gRPC through the Message Broker when enabled. Public business requests keep their REST contract. The optional Internal diagnostics folder uses internalBaseUrl and needs a local test port-forward; these routes must not be public Gateway routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "expectedGatewayVersion", "value": "0.4.1", "type": "string", "description": "Gateway 0.5.0 image currently reports runtime 0.4.1; update after a release changes the application version." },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "seededAuthenticId",
      "value": "c0000000-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "seededForgedId",
      "value": "c0000000-0000-4000-8000-000000000006",
      "type": "string"
    },
    {
      "key": "applicantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "credentialId",
      "value": "",
      "type": "string"
    },
    {
      "key": "integrityHash",
      "value": "",
      "type": "string"
    },
    {
      "key": "internalBaseUrl",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "runInternalDiagnostics",
      "value": "false",
      "type": "string"
    },
    {
      "key": "runLab4GatewayChecks",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Get Gateway Health Status (the service's own health is checked by Compose)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"reports Healthy\", () => pm.expect(body.status).to.eql(\"Healthy\"));",
                  "pm.test(\"reports Gateway health\", () => pm.expect(body.service).to.eql(\"gateway-service\"));",
                  "pm.test(\"reports the configured Gateway runtime version\", () => pm.expect(body.version).to.eql(pm.variables.get(\"expectedGatewayVersion\")));",
                  "pm.test(\"reports instance identity\", () => pm.expect(body.instanceId).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"reports valid load\", () => pm.expect([\"NORMAL\", \"HIGH\", \"CRITICAL\"]).to.include(body.load));",
                  "pm.test(\"reports capacity\", () => { pm.expect(body.maxThreads).to.be.a(\"number\").and.above(0); pm.expect(body.activeThreads).to.be.a(\"number\").and.at.least(0).and.at.most(body.maxThreads); });",
                  "pm.test(\"returns request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[A-Za-z0-9._:-]{1,64}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Get Seeded Authentic Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has the contract shape\", () => pm.expect(Object.keys(body)).to.eql([\"id\",\"applicantId\",\"documentType\",\"fields\",\"issuedAt\",\"expiresAt\",\"integrityHash\",\"issuingAuthority\"]));",
                  "pm.test(\"is Diana Popescu's student ID\", () => {",
                  "  pm.expect(body.documentType).to.eql(\"STUDENT_ID\");",
                  "  pm.expect(body.fields).to.eql({ fullName: \"Diana Popescu\", studentId: \"1234567890\", faculty: \"FAF\", year: 3 });",
                  "});",
                  "pm.collectionVariables.set(\"seededAuthenticHash\", body.integrityHash);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{seededAuthenticId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{seededAuthenticId}}"
              ]
            }
          }
        },
        {
          "name": "Verify Seeded Authentic Hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"the hash is valid\", () => pm.expect(body.valid).to.eql(true));",
                  "pm.test(\"names the credential\", () => pm.expect(body.credentialId).to.eql(pm.collectionVariables.get(\"seededAuthenticId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{seededAuthenticId}}/verify-hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{seededAuthenticId}}",
                "verify-hash"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providedHash\": \"{{seededAuthenticHash}}\"\n}"
            }
          }
        },
        {
          "name": "Get Seeded Forged Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"carries a fake authority\", () => pm.expect(body.issuingAuthority).to.eql(\"FAF Student Council\"));",
                  "pm.collectionVariables.set(\"seededForgedHash\", body.integrityHash);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{seededForgedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{seededForgedId}}"
              ]
            }
          }
        },
        {
          "name": "Verify Seeded Fabricated Hash Fails",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the printed hash is not the registrar's\", () => pm.expect(pm.response.json().valid).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{seededForgedId}}/verify-hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{seededForgedId}}",
                "verify-hash"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providedHash\": \"{{seededForgedHash}}\"\n}"
            }
          }
        },
        {
          "name": "Issue Authentic Credential",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"applicantId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"has the contract shape\", () => pm.expect(Object.keys(body)).to.eql([\"id\",\"applicantId\",\"documentType\",\"fields\",\"issuedAt\",\"expiresAt\",\"integrityHash\",\"issuingAuthority\"]));",
                  "pm.test(\"points Location at the bundle\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/credentials/${body.id}`));",
                  "pm.test(\"belongs to the applicant\", () => pm.expect(body.applicantId).to.eql(pm.collectionVariables.get(\"applicantId\")));",
                  "pm.test(\"the registry name is printed\", () => pm.expect(body.fields.fullName).to.eql(\"Diana Popescu\"));",
                  "pm.test(\"is issued by the registrar\", () => pm.expect(body.issuingAuthority).to.eql(\"Technical University of Moldova / Registrar\"));",
                  "pm.test(\"hash is a sha256 digest\", () => pm.expect(body.integrityHash).to.match(/^[0-9a-f]{64}$/));",
                  "pm.collectionVariables.set(\"credentialId\", body.id);",
                  "pm.collectionVariables.set(\"integrityHash\", body.integrityHash);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/issue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "issue"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicantId\": \"{{applicantId}}\",\n  \"isLegitimate\": true,\n  \"seed\": {\n    \"studentId\": \"1234567890\",\n    \"faculty\": \"FAF\",\n    \"year\": 3\n  }\n}"
            }
          }
        },
        {
          "name": "Fetch Issued Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is the issued bundle\", () => pm.expect(pm.response.json().integrityHash).to.eql(pm.collectionVariables.get(\"integrityHash\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}"
              ]
            }
          }
        },
        {
          "name": "List Credentials Of Applicant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"lists the one bundle\", () => {",
                  "  pm.expect(body.credentials).to.have.lengthOf(1);",
                  "  pm.expect(body.credentials[0].id).to.eql(pm.collectionVariables.get(\"credentialId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials?applicantId={{applicantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials"
              ],
              "query": [
                {
                  "key": "applicantId",
                  "value": "{{applicantId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Issued Hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the hash is valid\", () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}/verify-hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}",
                "verify-hash"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providedHash\": \"{{integrityHash}}\"\n}"
            }
          }
        },
        {
          "name": "Issue Forged Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"prints the claimed faculty\", () => pm.expect(body.fields.faculty).to.eql(\"FAF\"));",
                  "pm.test(\"keeps the holder's name\", () => pm.expect(body.fields.fullName).to.eql(\"Andrei Munteanu\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/issue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "issue"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicantId\": \"{{applicantId}}\",\n  \"isLegitimate\": false,\n  \"seed\": {\n    \"studentId\": \"2234567890\",\n    \"faculty\": \"FAF\",\n    \"year\": 1\n  }\n}"
            }
          }
        },
        {
          "name": "Reissue Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is reissued\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"credentialId\"));",
                  "  pm.expect(body.documentType).to.eql(\"ENROLLMENT_CONFIRMATION\");",
                  "  pm.expect(body.expiresAt).to.eql(\"2030-06-30T23:59:59Z\");",
                  "});",
                  "pm.test(\"is re-signed\", () => pm.expect(body.integrityHash).to.not.eql(pm.collectionVariables.get(\"integrityHash\")));",
                  "pm.collectionVariables.set(\"integrityHash\", body.integrityHash);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"ENROLLMENT_CONFIRMATION\",\n  \"fields\": {\n    \"fullName\": \"Diana Popescu\",\n    \"studentId\": \"1234567890\",\n    \"faculty\": \"FAF\",\n    \"year\": 3\n  },\n  \"expiresAt\": \"2030-06-30T23:59:59Z\"\n}"
            }
          }
        },
        {
          "name": "Verify Reissued Hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the new hash is valid\", () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}/verify-hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}",
                "verify-hash"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providedHash\": \"{{integrityHash}}\"\n}"
            }
          }
        },
        {
          "name": "Revoke Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}"
              ]
            }
          }
        },
        {
          "name": "Fetch Revoked Credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error is CREDENTIAL_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"CREDENTIAL_NOT_FOUND\"));",
                  "pm.test(\"has a message\", () => pm.expect(body.message).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credentials/{{credentialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credentials",
                "{{credentialId}}"
              ]
            }
          }
        }
      ]
    },
