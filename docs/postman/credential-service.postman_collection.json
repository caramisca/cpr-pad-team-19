                  "// The Gateway rejects paths no service owns with the common ROUTE_NOT_FOUND code;",
                  "// a service instance (X-Instance-Id present) answers NOT_FOUND for its own unknown paths.",
                  "const fromInstance = pm.response.headers.has(\"X-Instance-Id\");",
                  "const expected = fromInstance ? \"NOT_FOUND\" : \"ROUTE_NOT_FOUND\";",
                  "pm.test(\"error is \" + expected, () => pm.expect(body.error).to.eql(expected));",
