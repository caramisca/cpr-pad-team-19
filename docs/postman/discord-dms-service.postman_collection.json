              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sessionStartedEventId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"sessionId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"moderatorId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"one notification is queued for the moderator\", () => {",
                  "  pm.expect(body.eventId).to.eql(pm.collectionVariables.get(\"sessionStartedEventId\"));",
                  "  pm.expect(body.duplicate).to.eql(false);",
                  "  pm.expect(body.notificationIds).to.have.lengthOf(1);",
                  "});",
                  "pm.collectionVariables.set(\"sessionStartedNotificationIds\", JSON.stringify(body.notificationIds));"
