                  "pm.test(\"the redelivery is recognised and changes nothing\", () => {",
                  "  pm.expect(body.eventId).to.eql(pm.collectionVariables.get(\"sessionStartedEventId\"));",
                  "  pm.expect(body.duplicate).to.eql(true);",
                  "  pm.expect(JSON.stringify(body.notificationIds)).to.eql(pm.collectionVariables.get(\"sessionStartedNotificationIds\"));",
