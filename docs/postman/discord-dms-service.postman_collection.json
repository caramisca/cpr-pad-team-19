{
  "info": {
    "name": "discord-dms-service",
    "description": "Notification endpoints for discord-dms-service (Team 19, Topic 3: Student ID, Please). Run requests top to bottom, or use the Collection Runner: later requests depend on ids captured from earlier responses. Discord is simulated: recipient 00000000-0000-0000-0000-000000000403 does not accept direct messages, and any random recipient receives its message on the first attempt. Get Failed Notification waits 3 s for the delivery worker. The Event Delivery folder plays one shift through POST /internal/events/{eventType}, which delivers the consumed events until the message broker exists.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
