  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Get Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"service and Redis are healthy\", () => {",
                  "  pm.expect(body.status).to.eql(\"Healthy\");",
                  "  pm.expect(body.service).to.eql(\"discord-dms-service\");",
                  "  pm.expect(body.checks.redis).to.eql(\"Healthy\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Queue Direct Message",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"recipientId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"notification is queued\", () => {",
                  "  pm.expect(body.id).to.be.a(\"string\");",
                  "  pm.expect(body.status).to.eql(\"QUEUED\");",
                  "  pm.expect(body.createdAt).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Location points at the delivery status\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/notifications/\" + body.id + \"/status\"));",
                  "pm.collectionVariables.set(\"notificationId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"{{recipientId}}\",\n  \"type\": \"VERDICT\",\n  \"message\": \"Your application to join the server was accepted.\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notifications/dm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "dm"
              ]
            }
          }
        },
        {
          "name": "Get Notification Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"reports the delivery status\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"notificationId\"));",
                  "  pm.expect([\"QUEUED\", \"RATE_LIMITED\", \"SENT\"]).to.include(body.status);",
                  "  pm.expect(body.attempts).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Get Notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the queued message\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"notificationId\"));",
                  "  pm.expect(body.recipientId).to.eql(pm.collectionVariables.get(\"recipientId\"));",
                  "  pm.expect(body.type).to.eql(\"VERDICT\");",
                  "  pm.expect(body.message).to.eql(\"Your application to join the server was accepted.\");",
                  "  pm.expect(body.metadata).to.eql({ source: \"postman\" });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}"
              ]
            }
          }
        },
        {
          "name": "Queue Direct Message To Recipient With Closed DMs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"notification is queued\", () => {",
                  "  pm.expect(body.id).to.be.a(\"string\");",
                  "  pm.expect(body.status).to.eql(\"QUEUED\");",
                  "  pm.expect(body.createdAt).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Location points at the delivery status\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/notifications/\" + body.id + \"/status\"));",
                  "pm.collectionVariables.set(\"failedNotificationId\", body.id);"
                ]
