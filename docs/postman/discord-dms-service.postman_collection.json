          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"00000000-0000-0000-0000-000000000403\",\n  \"type\": \"VERDICT\",\n  \"message\": \"Your application to join the server was accepted.\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notifications/dm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "dm"
              ]
            }
          }
        },
        {
          "name": "Get Failed Notification",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the delivery worker time to make its first attempt.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Discord refused the message for good\", () => {",
                  "  pm.expect(body.status).to.eql(\"FAILED\");",
                  "  pm.expect(body.attempts).to.eql(1);",
                  "  pm.expect(body.nextAttemptAt).to.eql(null);",
                  "  pm.expect(body.lastError).to.include(\"403\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{failedNotificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{failedNotificationId}}"
              ]
            }
          }
        },
        {
          "name": "Retry Failed Notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"queued again with a fresh attempt budget\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"failedNotificationId\"));",
                  "  pm.expect(body.status).to.eql(\"QUEUED\");",
                  "  pm.expect(body.attempts).to.eql(0);",
                  "});",
                  "pm.test(\"Location points at the delivery status\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/notifications/\" + body.id + \"/status\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{failedNotificationId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{failedNotificationId}}",
                "retry"
              ]
            }
          }
        },
        {
          "name": "Delete Notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{failedNotificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{failedNotificationId}}"
              ]
            }
          }
        },
        {
          "name": "Get Deleted Notification Returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is NOTIFICATION_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"NOTIFICATION_NOT_FOUND\"));",
                  "pm.test(\"error has a message\", () => pm.expect(body.message).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{failedNotificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{failedNotificationId}}"
              ]
            }
          }
        }
