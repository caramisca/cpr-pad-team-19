              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"errorSessionId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "if (!pm.collectionVariables.get(\"moderatorId\")) {",
                  "  pm.collectionVariables.set(\"moderatorId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
