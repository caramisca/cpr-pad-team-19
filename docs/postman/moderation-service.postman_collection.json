        {
          "name": "Record Decision With Unknown Credential Returns 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is CREDENTIAL_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"CREDENTIAL_NOT_FOUND\"));",
                  "pm.test(\"error has a message\", () => pm.expect(body.message).to.be.a(\"string\"));"
