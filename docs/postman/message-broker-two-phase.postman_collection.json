      "item": [
        {
          "name": "Register A Player At Its Instance",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compose doesn't publish the instances: these requests need an instance URL (a jar run",
                  "// locally, or newman on the Compose network). Without one they're skipped.",
                  "if (!pm.variables.get(\"playerInstanceUrl\")) { pm.execution.skipRequest(); }",
                  "pm.variables.set(\"discordId\", \"discord-postman-broker-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the new player's id\", () => pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "pm.collectionVariables.set(\"playerId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
