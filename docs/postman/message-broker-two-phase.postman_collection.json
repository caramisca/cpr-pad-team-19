                  "  pm.expect(body.participants[0]).to.not.have.property(\"payload\");",
                  "});",
                  "pm.test(\"decided ABORTED and finished\", () => {",
                  "  pm.expect(body.transactionId).to.eql(pm.collectionVariables.get(\"abortedTransactionId\"));",
                  "  pm.expect(body.state).to.eql(\"ABORTED\");",
                  "  pm.expect(body.completed).to.eql(true);",
                  "  pm.expect(Date.parse(body.decidedAt)).to.not.be.NaN;",
                  "  pm.expect(Date.parse(body.completedAt)).to.not.be.NaN;",
                  "});",
                  "pm.test(\"player-service voted NO with its refusal\", () => {",
                  "  pm.expect(body.participants[0].vote).to.eql(\"NO\");",
                  "  pm.expect(body.participants[0].reason).to.include(\"TRANSACTION_REFUSED\");",
                  "  pm.expect(body.participants[0].outcome).to.eql(\"ABORTED\");",
                  "  pm.expect(body.reason).to.include(\"player-service voted NO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{brokerUrl}}/two-phase/transactions/{{abortedTransactionId}}", "host": ["{{brokerUrl}}"], "path": ["two-phase", "transactions", "{{abortedTransactionId}}"] }
          }
        },
        {
          "name": "Run The Same Transaction Again Answers The Logged Decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"body has the transaction shape\", () => {",
                  "  pm.expect(body).to.include.all.keys(\"transactionId\", \"source\", \"state\", \"completed\", \"reason\", \"createdAt\", \"decidedAt\", \"completedAt\", \"participants\");",
                  "  pm.expect(body.source).to.eql(\"server-moderation-session-service\");",
                  "  pm.expect(body.participants).to.be.an(\"array\").with.lengthOf(1);",
                  "  pm.expect(body.participants[0]).to.have.all.keys(\"service\", \"vote\", \"reason\", \"outcome\");",
                  "  pm.expect(body.participants[0]).to.not.have.property(\"payload\");",
                  "});",
                  "pm.test(\"decided ABORTED and finished\", () => {",
                  "  pm.expect(body.transactionId).to.eql(pm.collectionVariables.get(\"abortedTransactionId\"));",
                  "  pm.expect(body.state).to.eql(\"ABORTED\");",
                  "  pm.expect(body.completed).to.eql(true);",
                  "  pm.expect(Date.parse(body.decidedAt)).to.not.be.NaN;",
                  "  pm.expect(Date.parse(body.completedAt)).to.not.be.NaN;",
                  "});",
                  "pm.test(\"player-service voted NO with its refusal\", () => {",
                  "  pm.expect(body.participants[0].vote).to.eql(\"NO\");",
                  "  pm.expect(body.participants[0].reason).to.include(\"TRANSACTION_REFUSED\");",
                  "  pm.expect(body.participants[0].outcome).to.eql(\"ABORTED\");",
                  "  pm.expect(body.reason).to.include(\"player-service voted NO\");",
                  "});",
                  "pm.test(\"the same transaction, not a new one\", () => pm.expect(body.createdAt).to.eql(pm.collectionVariables.get(\"abortedCreatedAt\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{abortedTransactionId}}\",\n  \"source\": \"server-moderation-session-service\",\n  \"participants\": [\n    {\n      \"service\": \"player-service\",\n      \"payload\": { \"moderatorId\": \"00000000-0000-0000-0000-000000000000\", \"juniorModeratorIds\": [], \"closedAt\": \"{{closedAt}}\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{brokerUrl}}/two-phase/transactions", "host": ["{{brokerUrl}}"], "path": ["two-phase", "transactions"] }
          }
        }
      ]
    },
    {
      "name": "Every Participant Votes YES (needs playerInstanceUrl)",
