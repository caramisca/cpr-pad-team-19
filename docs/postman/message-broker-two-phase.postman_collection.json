    {
      "name": "List Transactions",
      "description": "Newest first; `state` filters (`PREPARING`, `COMMITTED`, `ABORTED`), `limit` 1–1000 (default 100). Payloads are never shown.",
      "item": [
        {
          "name": "List Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"body is {total, transactions}\", () => {",
                  "  pm.expect(body.total).to.be.a(\"number\").and.at.least(1);",
                  "  pm.expect(body.transactions).to.be.an(\"array\").and.not.empty;",
                  "  pm.expect(body.transactions.length).to.be.at.most(body.total);",
                  "});",
                  "pm.test(\"newest first\", () => {",
                  "  const times = body.transactions.map((t) => Date.parse(t.createdAt));",
                  "  pm.expect(times).to.eql([...times].sort((a, b) => b - a));",
                  "});",
                  "pm.test(\"includes the aborted transaction\", () => pm.expect(body.transactions.map((t) => t.transactionId)).to.include(pm.collectionVariables.get(\"abortedTransactionId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{brokerUrl}}/two-phase/transactions", "host": ["{{brokerUrl}}"], "path": ["two-phase", "transactions"] }
          }
        },
        {
          "name": "List Aborted Transactions With A Limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"at most 2, all ABORTED\", () => {",
                  "  pm.expect(body.transactions.length).to.be.within(1, 2);",
                  "  body.transactions.forEach((t) => pm.expect(t.state).to.eql(\"ABORTED\"));",
                  "  pm.expect(body.total).to.be.at.least(body.transactions.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{brokerUrl}}/two-phase/transactions?state=ABORTED&limit=2", "host": ["{{brokerUrl}}"], "path": ["two-phase", "transactions"], "query": [{ "key": "state", "value": "ABORTED" }, { "key": "limit", "value": "2" }] }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "description": "`404 TRANSACTION_NOT_FOUND` (a participant treats it as aborted: presumed abort) and `400 VALIDATION_ERROR` for a start or a listing the coordinator can't accept. `409 TRANSACTION_IN_PROGRESS` (+ `Retry-After: 1`) only happens while a transaction with the same ID is still being prepared, so it isn't requested here.",
      "item": [
        {
          "name": "Get An Unknown Transaction Returns 404",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"unknownTransactionId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
