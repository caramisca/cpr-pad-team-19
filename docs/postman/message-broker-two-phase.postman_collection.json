{
  "info": {
    "name": "message-broker-two-phase",
    "description": "The two-phase commit coordinator of message-broker 0.6.0 (Team 19, Topic 3: Student ID, Please; Lab 5, Grade 8; owner Daria). Closing a shift is one transaction across `server-moderation-session-service`'s and `player-service`'s databases; the broker runs it: `POST /two-phase/transactions` (both phases, answers the decision), `GET /two-phase/transactions/{transactionId}`, `GET /two-phase/transactions?state=&limit=`. Contract: the CPR's `contracts/two-phase.md`; runbook: `docs/LAB_5_TWO_PHASE_COMMIT.md`. The broker is at `brokerUrl` (its HTTP port 8091, on the Compose network only: run newman there, e.g. `http://message-broker:8091`) and needs no API key: it is not a Gateway route. The requests here run real transactions with `player-service` as the only participant, over gRPC `ServiceEndpoint.Call`: a NO vote (an unregistered moderator) and, with `playerInstanceUrl` set (e.g. `http://player-service:8081`; empty, those requests are skipped), a commit whose credited shift is then read back. The whole shift close, through the Gateway, is in the `server-moderation-session-service` collection. Every request sends its own `X-Request-Id` and checks that it comes back, and every error is checked for the `{error, message}` shape. Run the folders top to bottom. The status, topics and dead letter channel are in the `message-broker` collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every request sends its own request ID; the broker logs it and sends it back.",
          "pm.variables.set(\"requestId\", \"postman-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
          "pm.request.headers.upsert({ key: \"X-Request-Id\", value: pm.variables.get(\"requestId\") });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"echoes the request ID\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.eql(pm.variables.get(\"requestId\")));",
          "if (pm.response.code >= 400) {",
          "  pm.test(\"error body is {error, message}\", () => {",
          "    const error = pm.response.json();",
          "    pm.expect(error.error).to.be.a(\"string\").and.match(/^[A-Z_]+$/);",
          "    pm.expect(error.message).to.be.a(\"string\").and.not.empty;",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "brokerUrl", "value": "http://localhost:8091", "type": "string" },
    { "key": "playerInstanceUrl", "value": "", "type": "string" },
    { "key": "abortedTransactionId", "value": "", "type": "string" },
    { "key": "abortedCreatedAt", "value": "", "type": "string" },
    { "key": "committedTransactionId", "value": "", "type": "string" },
    { "key": "closedAt", "value": "", "type": "string" },
    { "key": "playerId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "A Participant Votes NO",
      "description": "`player-service` refuses a moderator who isn't a registered player, so the coordinator aborts. Asking again with the same `transactionId` answers the logged decision without preparing again.",
      "item": [
        {
          "name": "Run A Transaction A Participant Refuses",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"abortedTransactionId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"closedAt\", new Date().toISOString());",
                  "pm.variables.set(\"unregisteredModeratorId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"body has the transaction shape\", () => {",
                  "  pm.expect(body).to.include.all.keys(\"transactionId\", \"source\", \"state\", \"completed\", \"reason\", \"createdAt\", \"decidedAt\", \"completedAt\", \"participants\");",
                  "  pm.expect(body.source).to.eql(\"server-moderation-session-service\");",
                  "  pm.expect(body.participants).to.be.an(\"array\").with.lengthOf(1);",
                  "  pm.expect(body.participants[0]).to.have.all.keys(\"service\", \"vote\", \"reason\", \"outcome\");",
                  "  pm.expect(body.participants[0]).to.not.have.property(\"payload\");",
                  "});",
                  "pm.test(\"decided ABORTED and finished\", () => {",
                  "  pm.expect(body.transactionId).to.eql(pm.collectionVariables.get(\"abortedTransactionId\"));",
                  "  pm.expect(body.state).to.eql(\"ABORTED\");",
                  "  pm.expect(body.completed).to.eql(true);",
                  "  pm.expect(Date.parse(body.decidedAt)).to.not.be.NaN;",
                  "  pm.expect(Date.parse(body.completedAt)).to.not.be.NaN;",
                  "});",
                  "pm.test(\"player-service voted NO with its refusal\", () => {",
                  "  pm.expect(body.participants[0].vote).to.eql(\"NO\");",
                  "  pm.expect(body.participants[0].reason).to.include(\"TRANSACTION_REFUSED\");",
                  "  pm.expect(body.participants[0].outcome).to.eql(\"ABORTED\");",
                  "  pm.expect(body.reason).to.include(\"player-service voted NO\");",
                  "});",
                  "pm.collectionVariables.set(\"abortedCreatedAt\", body.createdAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{abortedTransactionId}}\",\n  \"source\": \"server-moderation-session-service\",\n  \"participants\": [\n    {\n      \"service\": \"player-service\",\n      \"payload\": { \"moderatorId\": \"{{unregisteredModeratorId}}\", \"juniorModeratorIds\": [], \"closedAt\": \"{{closedAt}}\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{brokerUrl}}/two-phase/transactions", "host": ["{{brokerUrl}}"], "path": ["two-phase", "transactions"] },
            "description": "The participant that voted NO already rolled back, so no abort is sent to it: the transaction is finished (`completed`) at once."
          }
        },
        {
          "name": "Get The Aborted Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"body has the transaction shape\", () => {",
