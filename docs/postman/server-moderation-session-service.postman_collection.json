{
  "info": {
    "name": "server-moderation-session-service",
    "description": "CRUD endpoints for server-moderation-session-service (Team 19, Topic 3 — Student ID, Please). Run requests top to bottom, or use the Collection Runner — later requests depend on {{sessionId}} captured from the Open Session response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "moderatorId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Open Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"moderatorId\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"response has id\", () => pm.expect(body.id).to.be.a(\"string\"));",
                  "pm.test(\"moderatorId echoed back\", () => pm.expect(body.moderatorId).to.eql(pm.collectionVariables.get(\"moderatorId\")));",
                  "pm.test(\"starts OPEN\", () => pm.expect(body.status).to.eql(\"OPEN\"));",
                  "pm.collectionVariables.set(\"sessionId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"juniorModeratorIds\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
          }
        },
        {
          "name": "Get Session By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"id matches requested session\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"sessionId\")));",
                  "pm.test(\"fresh session has zeroed queue/applicants\", () => {",
                  "  pm.expect(body.queueLength).to.eql(0);",
                  "  pm.expect(body.applicantsProcessed).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}"] }
          }
        },
        {
          "name": "Close Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"status is CLOSED\", () => pm.expect(body.status).to.eql(\"CLOSED\"));",
                  "pm.test(\"closedAt is set\", () => pm.expect(body.closedAt).to.not.be.null);",
                  "pm.test(\"summary reflects no decisions yet\", () => pm.expect(body.summary.score).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/close", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "close"] }
          }
        },
        {
          "name": "Delete Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}"] }
          }
        },
        {
          "name": "Get Deleted Session Returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404 after delete\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is SESSION_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"SESSION_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}"] }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Seed Session For Close Conflict Check",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"moderatorId\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"sessionId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"juniorModeratorIds\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
          }
        },
        {
          "name": "Close Seeded Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/close", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "close"] }
          }
        },
        {
          "name": "Close Already-Closed Session Returns 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is SESSION_ALREADY_CLOSED\", () => pm.expect(body.error).to.eql(\"SESSION_ALREADY_CLOSED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/close", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "close"] }
          }
        },
        {
          "name": "Open Session Missing ModeratorId Returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is VALIDATION_ERROR\", () => pm.expect(body.error).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"juniorModeratorIds\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
          }
        },
        {
          "name": "Get Session With Invalid Uuid Returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is INVALID_PATH_VARIABLE\", () => pm.expect(body.error).to.eql(\"INVALID_PATH_VARIABLE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sessions/not-a-uuid", "host": ["{{baseUrl}}"], "path": ["sessions", "not-a-uuid"] }
          }
        },
        {
          "name": "Get Nonexistent Session Returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is SESSION_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"SESSION_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sessions/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "00000000-0000-0000-0000-000000000000"]
            }
          }
        },
        {
          "name": "Delete Nonexistent Session Returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"error code is SESSION_NOT_FOUND\", () => pm.expect(body.error).to.eql(\"SESSION_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/sessions/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    }
  ]
}
