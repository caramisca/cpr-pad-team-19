                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"one decision, although the saga was started twice\", () => pm.expect(body.decisions.map(d => d.id)).to.eql([pm.collectionVariables.get(\"decisionId\")]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/decisions",
              "host": [
