          }
        },
        {
          "name": "Get The Verdict Notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a VERDICT for the applicant\", () => { pm.expect(body.type).to.eql(\"VERDICT\"); pm.expect(body.recipientId).to.eql(\"a0000000-0000-4000-8000-000000000001\"); });",
                  "pm.test(\"metadata names the saga and the decision\", () => {",
                  "  pm.expect(body.metadata.eventType).to.eql(\"saga.decision-verdict\");",
                  "  pm.expect(body.metadata.sagaId).to.eql(pm.collectionVariables.get(\"sagaId\"));",
                  "  pm.expect(body.metadata.decisionId).to.eql(pm.collectionVariables.get(\"decisionId\"));",
                  "  pm.expect(body.metadata.action).to.eql(\"ACCEPT\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}"
              ]
            }
          }
        },
        {
          "name": "Amend The Confirmed Decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200: the semantic lock ends with the saga\", () => pm.response.to.have.status(200));",
                  "pm.test(\"amended to FLAG\", () => pm.expect(pm.response.json().action).to.eql(\"FLAG\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"action\": \"FLAG\" }"
            },
            "url": {
              "raw": "{{baseUrl}}/decisions/{{decisionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "decisions",
                "{{decisionId}}"
              ]
            }
          }
        },
        {
          "name": "List Completed Sagas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const sagas = pm.response.json().sagas;",
                  "pm.test(\"at most 5, all COMPLETED, without logs\", () => {",
                  "  pm.expect(sagas.length).to.be.within(1, 5);",
                  "  sagas.forEach(saga => { pm.expect(saga.state).to.eql(\"COMPLETED\"); pm.expect(saga).to.not.have.property(\"log\"); });",
                  "});",
                  "pm.test(\"newest first\", () => sagas.slice(1).forEach((saga, i) => pm.expect(Date.parse(saga.createdAt)).to.be.at.most(Date.parse(sagas[i].createdAt))));",
                  "pm.test(\"includes the saga just run\", () => pm.expect(sagas.map(s => s.sagaId)).to.include(pm.collectionVariables.get(\"sagaId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sagas?state=COMPLETED&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sagas"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "COMPLETED"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Start Saga With Unknown Credential Fails With 422",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"failedSessionId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422: moderation-service's answer\", () => pm.response.to.have.status(422));",
                  "const saga = pm.response.json();",
                  "pm.test(\"the saga FAILED with moderation's error\", () => {",
                  "  pm.expect(saga.state).to.eql(\"FAILED\");",
                  "  pm.expect(saga.error).to.eql(\"CREDENTIAL_NOT_FOUND\");",
                  "  pm.expect(saga.message).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(saga.cause).to.include({ step: \"record-decision\", status: 422 });",
                  "});",
                  "pm.test(\"step 1 FAILED, nothing else ran\", () => pm.expect(saga.steps.map(step => step.state)).to.eql([\"FAILED\", \"SKIPPED\", \"SKIPPED\"]));",
                  "pm.test(\"no decision was recorded\", () => pm.expect(saga.decisionId).to.eql(null));",
                  "pm.collectionVariables.set(\"failedSagaId\", saga.sagaId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
