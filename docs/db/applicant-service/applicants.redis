# Demo applicants for applicant-service, loaded by seed.sh when Redis holds none.
# __PREFIX__ is replaced with the service's Redis:InstanceName. Credentials c0000000-...-00000000000N
# are seeded by credential-service; the students are the demo students of university-record-service.
# 1. Diana Popescu - honest FAF student in year 3.
SET __PREFIX__applicant:a0000000-0000-4000-8000-000000000001 '{"id":"a0000000-0000-4000-8000-000000000001","sessionId":"5e55a0e0-0000-4000-8000-000000000001","name":"Diana Popescu","studentId":"1234567890","faculty":"FAF","year":3,"role":"STUDENT","photoRef":"https://assets.campus.local/photos/a0000000000040008000000000000001.png","credentialId":"c0000000-0000-4000-8000-000000000001","createdAt":"2026-09-24T09:00:00Z","expiresAt":"2027-09-01T00:00:00Z","difficulty":"MEDIUM","isLegitimate":true,"trueRole":"STUDENT","deceptions":[]}'
SADD __PREFIX__session:5e55a0e0-0000-4000-8000-000000000001:applicants a0000000-0000-4000-8000-000000000001
# 2. Andrei Munteanu - FCIM student claiming to study at FAF.
SET __PREFIX__applicant:a0000000-0000-4000-8000-000000000002 '{"id":"a0000000-0000-4000-8000-000000000002","sessionId":"5e55a0e0-0000-4000-8000-000000000001","name":"Andrei Munteanu","studentId":"2234567890","faculty":"FAF","year":1,"role":"STUDENT","photoRef":"https://assets.campus.local/photos/a0000000000040008000000000000002.png","credentialId":"c0000000-0000-4000-8000-000000000002","createdAt":"2026-09-24T09:00:00Z","expiresAt":"2027-09-01T00:00:00Z","difficulty":"MEDIUM","isLegitimate":false,"trueRole":"OTHER_MAJOR","deceptions":["FALSE_FACULTY_CLAIM"]}'
SADD __PREFIX__session:5e55a0e0-0000-4000-8000-000000000001:applicants a0000000-0000-4000-8000-000000000002
# 3. Elena Rusu - FAF graduate claiming to be enrolled in year 4.
SET __PREFIX__applicant:a0000000-0000-4000-8000-000000000003 '{"id":"a0000000-0000-4000-8000-000000000003","sessionId":"5e55a0e0-0000-4000-8000-000000000001","name":"Elena Rusu","studentId":"3234567890","faculty":"FAF","year":4,"role":"STUDENT","photoRef":"https://assets.campus.local/photos/a0000000000040008000000000000003.png","credentialId":"c0000000-0000-4000-8000-000000000003","createdAt":"2026-09-24T09:00:00Z","expiresAt":"2027-09-01T00:00:00Z","difficulty":"MEDIUM","isLegitimate":false,"trueRole":"ALUMNUS","deceptions":["FALSE_ENROLLMENT_CLAIM"]}'
SADD __PREFIX__session:5e55a0e0-0000-4000-8000-000000000001:applicants a0000000-0000-4000-8000-000000000003
# 4. Victor Ceban - outsider carrying Diana Popescu's student ID.
SET __PREFIX__applicant:a0000000-0000-4000-8000-000000000004 '{"id":"a0000000-0000-4000-8000-000000000004","sessionId":"5e55a0e0-0000-4000-8000-000000000001","name":"Victor Ceban","studentId":"1234567890","faculty":"FAF","year":3,"role":"STUDENT","photoRef":"https://assets.campus.local/photos/a0000000000040008000000000000004.png","credentialId":"c0000000-0000-4000-8000-000000000004","createdAt":"2026-09-24T09:00:00Z","expiresAt":"2027-09-01T00:00:00Z","difficulty":"MEDIUM","isLegitimate":false,"trueRole":"OUTSIDER","deceptions":["IMPERSONATION"]}'
SADD __PREFIX__session:5e55a0e0-0000-4000-8000-000000000001:applicants a0000000-0000-4000-8000-000000000004
# 5. Irina Cojocaru - honest FAF teaching assistant.
SET __PREFIX__applicant:a0000000-0000-4000-8000-000000000005 '{"id":"a0000000-0000-4000-8000-000000000005","sessionId":"5e55a0e0-0000-4000-8000-000000000001","name":"Irina Cojocaru","studentId":null,"faculty":"FAF","year":null,"role":"TA","photoRef":"https://assets.campus.local/photos/a0000000000040008000000000000005.png","credentialId":"c0000000-0000-4000-8000-000000000005","createdAt":"2026-09-24T09:00:00Z","expiresAt":"2027-09-01T00:00:00Z","difficulty":"MEDIUM","isLegitimate":true,"trueRole":"TA","deceptions":[]}'
