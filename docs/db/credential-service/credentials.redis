# Demo credential bundles for credential-service, loaded by seed.sh when Redis holds none.
# __PREFIX__ is replaced with the service's Redis:InstanceName. Generated; hashes follow CredentialHasher.
# 1. Diana Popescu - honest FAF student, year 3: authentic student ID.
SET __PREFIX__credential:c0000000-0000-4000-8000-000000000001 '{"id":"c0000000-0000-4000-8000-000000000001","applicantId":"a0000000-0000-4000-8000-000000000001","documentType":"STUDENT_ID","fields":{"fullName":"Diana Popescu","studentId":"1234567890","faculty":"FAF","year":3},"issuedAt":"2026-09-01T08:00:00Z","expiresAt":"2027-06-30T23:59:59Z","integrityHash":"0bfda147385d93742b9dd0dc76bb625679d4b21a35d49a9d4f8e081361883ccc","issuingAuthority":"Technical University of Moldova / Registrar","registrarHash":"0bfda147385d93742b9dd0dc76bb625679d4b21a35d49a9d4f8e081361883ccc","isLegitimate":true,"forgeries":[]}'
SADD __PREFIX__credentials:by-applicant:a0000000-0000-4000-8000-000000000001 c0000000-0000-4000-8000-000000000001
